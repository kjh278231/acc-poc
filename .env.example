# OpenRouter key: used for both Haiku (chat completions) and Jev (POST /api/v1/systemone)
OPENROUTER_API_KEY=
# live | mock  (mock = deterministic offline stand-ins, never mixed into benchmark results)
LLM_MODE=live
HAIKU_MODEL=anthropic/claude-haiku-5.5
# none | low | medium  (none = thinking disabled; lowest latency)
HAIKU_REASONING=none
JEV_MODEL=typesafe/jev-1.14
JEV_FALLBACK_MODEL=typesafe/jev-1.13
JEV_CONFIDENCE_THRESHOLD=0.8
# A2A bearer key that Amazon Connect will present (stored in Secrets Manager on the AWS side)
A2A_API_KEY=local-dev-key
# Hard cap per benchmark run (USD)
BENCH_MAX_COST_USD=2.0
