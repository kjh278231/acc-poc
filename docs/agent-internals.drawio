<mxfile host="drawio" version="26.0.0"><diagram id="agent-internals" name="오디오 에이전트 내부"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;오디오 에이전트 내부 구성&lt;/b&gt; (agent/audio-agent/bridge · A2A_ENGINE=cascade · 2026-11-20)" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="30" as="geometry"/></mxCell><mxCell id="connect" value="&lt;b&gt;Amazon Connect&lt;/b&gt;&lt;br&gt;A2A 오디오 핸드오프&lt;br&gt;(Orchestrator → A2A_SERVER 앱)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="255" width="160" height="90" as="geometry"/></mxCell><mxCell id="bridge" value="ECS 태스크 · bridge 컨테이너 (aiohttp :8080, python -m bridge.server)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF5EC;strokeColor=#D45B07;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#D45B07;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="230" y="40" width="1040" height="900" as="geometry"/></mxCell><mxCell id="health" value="&lt;b&gt;GET /health&lt;/b&gt;&lt;br&gt;ALB 상태 확인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="bridge"><mxGeometry x="20" y="50" width="170" height="50" as="geometry"/></mxCell><mxCell id="testpage" value="&lt;b&gt;/test · /test/start · /test/stop · /test/transcript&lt;/b&gt; (testpage.py)&lt;br&gt;웹콜 테스트 페이지 → StartWebRTCContact&lt;br&gt;대화 스크립트 1초 폴링 (태스크 메모리 보관)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;arcSize=8;dashed=1;" vertex="1" parent="bridge"><mxGeometry x="230" y="50" width="340" height="50" as="geometry"/></mxCell><mxCell id="ws" value="&lt;b&gt;GET /a2a&lt;/b&gt;&lt;br&gt;WebSocket 업그레이드" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="bridge"><mxGeometry x="20" y="230" width="170" height="60" as="geometry"/></mxCell><mxCell id="bearer" value="&lt;b&gt;bearer.py&lt;/b&gt;&lt;br&gt;Bearer 키 비교 (불일치 401)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;arcSize=8;" vertex="1" parent="bridge"><mxGeometry x="20" y="330" width="170" height="55" as="geometry"/></mxCell><mxCell id="secrets" value="&lt;b&gt;secrets.py&lt;/b&gt; SecretCache&lt;br&gt;Secrets Manager에서 키 조회 후 캐시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;arcSize=8;" vertex="1" parent="bridge"><mxGeometry x="20" y="420" width="170" height="65" as="geometry"/></mxCell><mxCell id="config" value="&lt;b&gt;config.py&lt;/b&gt; CONFIG&lt;br&gt;환경변수: 엔진·언어·음성·LLM·TMS URL·타이밍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;arcSize=8;" vertex="1" parent="bridge"><mxGeometry x="20" y="520" width="170" height="75" as="geometry"/></mxCell><mxCell id="session" value="server.py · Session (A2A 상태 기계, 통화당 1개)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;container=1;pointerEvents=0;collapsible=0;dashed=0;" vertex="1" parent="bridge"><mxGeometry x="230" y="130" width="320" height="470" as="geometry"/></mxCell><mxCell id="states" value="&lt;b&gt;AwaitInit → AwaitReady → Live → Finishing&lt;/b&gt;&lt;br&gt;INIT_SESSION_RESPONSE(16 kHz 역제안) · CHANNEL_STATE READY에 엔진 시작" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=8;" vertex="1" parent="session"><mxGeometry x="10" y="40" width="300" height="60" as="geometry"/></mxCell><mxCell id="frag" value="&lt;b&gt;FragmentReassembler&lt;/b&gt; (kit)&lt;br&gt;입력 PCM 조각 재조립 → send_audio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="session"><mxGeometry x="10" y="110" width="300" height="50" as="geometry"/></mxCell><mxCell id="rechunk" value="&lt;b&gt;audio.py&lt;/b&gt; Rechunker&lt;br&gt;출력 PCM을 100 ms 프레임으로" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="session"><mxGeometry x="10" y="170" width="300" height="50" as="geometry"/></mxCell><mxCell id="frames" value="&lt;b&gt;a2a.py&lt;/b&gt; 프레임 빌더 (kit)&lt;br&gt;AUDIO_RESPONSE_CHUNK · INTERRUPTION · FINISH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="session"><mxGeometry x="10" y="230" width="300" height="55" as="geometry"/></mxCell><mxCell id="trace" value="&lt;b&gt;tracing.py&lt;/b&gt; TurnTrace&lt;br&gt;턴마다 TRACING_SPAN (chat · execute_tool span)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="session"><mxGeometry x="10" y="295" width="300" height="50" as="geometry"/></mxCell><mxCell id="keepalive" value="&lt;b&gt;keepalive&lt;/b&gt;&lt;br&gt;3초간 보낸 음성이 없으면 100 ms 무음 프레임" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=8;" vertex="1" parent="session"><mxGeometry x="10" y="355" width="300" height="45" as="geometry"/></mxCell><mxCell id="finish" value="&lt;b&gt;_finish_when_quiet → _finish&lt;/b&gt;&lt;br&gt;작별 음성 재생이 끝나면 FINISH COMPLETE, 소켓 종료" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=8;" vertex="1" parent="session"><mxGeometry x="10" y="410" width="300" height="50" as="geometry"/></mxCell><mxCell id="tools" value="local_tools.py · LocalTools" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;container=1;pointerEvents=0;collapsible=0;dashed=0;" vertex="1" parent="bridge"><mxGeometry x="230" y="640" width="320" height="240" as="geometry"/></mxCell><mxCell id="endcall" value="&lt;b&gt;end_call&lt;/b&gt;(outcome, summary, reason)&lt;br&gt;→ PendingFinish(COMPLETE): Connect에는 항상 COMPLETE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=8;" vertex="1" parent="tools"><mxGeometry x="10" y="40" width="300" height="55" as="geometry"/></mxCell><mxCell id="callback" value="&lt;b&gt;ESCALATE → _request_callback&lt;/b&gt;&lt;br&gt;DescribeContact로 고객 번호 → TMS POST (1.5초 × 2회)&lt;br&gt;실패·URL 없음 → CALLBACK_NOT_FILED 로그" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=8;" vertex="1" parent="tools"><mxGeometry x="10" y="105" width="300" height="70" as="geometry"/></mxCell><mxCell id="tms" value='&lt;b&gt;TMS mock&lt;/b&gt; (A2A_TMS_URL=mock)&lt;br&gt;0.5초 후 {"status": "received"}' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;arcSize=8;dashed=1;" vertex="1" parent="tools"><mxGeometry x="10" y="185" width="300" height="45" as="geometry"/></mxCell><mxCell id="cascade" value="engines/cascade.py · CascadeSession" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;container=1;pointerEvents=0;collapsible=0;dashed=0;" vertex="1" parent="bridge"><mxGeometry x="620" y="130" width="400" height="510" as="geometry"/></mxCell><mxCell id="vad" value="&lt;b&gt;EnergyVad&lt;/b&gt; (base.py)&lt;br&gt;입력 PCM 에너지로 말 시작·끝 감지" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=8;" vertex="1" parent="cascade"><mxGeometry x="15" y="40" width="175" height="60" as="geometry"/></mxCell><mxCell id="stt" value="&lt;b&gt;TranscribeStream&lt;/b&gt;&lt;br&gt;(transcribe_ws.py)&lt;br&gt;입력 PCM → partial / final" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=8;" vertex="1" parent="cascade"><mxGeometry x="210" y="40" width="175" height="60" as="geometry"/></mxCell><mxCell id="eou" value="&lt;b&gt;턴 종료 판단&lt;/b&gt;&lt;br&gt;final 뒤 150 ms 새 partial 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=8;" vertex="1" parent="cascade"><mxGeometry x="210" y="125" width="175" height="50" as="geometry"/></mxCell><mxCell id="respond" value="&lt;b&gt;_respond / _llm_round&lt;/b&gt;&lt;br&gt;ConverseStream 토큰 → ThinkingFilter → SentenceSplitter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=8;" vertex="1" parent="cascade"><mxGeometry x="210" y="200" width="175" height="65" as="geometry"/></mxCell><mxCell id="bargein" value="&lt;b&gt;_barge_in&lt;/b&gt;&lt;br&gt;에이전트 발화 중 VAD 400 ms 또는 partial 2글자 → LLM·TTS 취소" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=8;" vertex="1" parent="cascade"><mxGeometry x="15" y="285" width="175" height="65" as="geometry"/></mxCell><mxCell id="polly" value="&lt;b&gt;PollyTts&lt;/b&gt; (base.py)&lt;br&gt;문장마다 합성 · pcm 16 kHz&lt;br&gt;A2A_TTS_RATE → SSML prosody 속도" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=8;" vertex="1" parent="cascade"><mxGeometry x="210" y="285" width="175" height="65" as="geometry"/></mxCell><mxCell id="emitter" value="&lt;b&gt;EventEmitter&lt;/b&gt; (base.py)&lt;br&gt;Nova 형식 이벤트: audio · text · toolUse(end_call) · interrupted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="cascade"><mxGeometry x="15" y="370" width="370" height="50" as="geometry"/></mxCell><mxCell id="persona" value="&lt;b&gt;persona_ko.txt&lt;/b&gt; + end_call 스펙&lt;br&gt;LLM 시스템 프롬프트 · temperature 0 · topK 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;arcSize=8;" vertex="1" parent="cascade"><mxGeometry x="15" y="435" width="175" height="60" as="geometry"/></mxCell><mxCell id="idle" value="&lt;b&gt;_idle_watchdog&lt;/b&gt;&lt;br&gt;25초 무발화 재질문 · 50초면 작별 후 종료" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=8;" vertex="1" parent="cascade"><mxGeometry x="210" y="435" width="175" height="60" as="geometry"/></mxCell><mxCell id="steps" value="&lt;b&gt;흐름&lt;/b&gt;&lt;br&gt;① Connect ↔ /a2a 웹소켓 (Bearer 키, PCM 16bit 양방향)&lt;br&gt;② A2A 프레임을 Session이 처리&lt;br&gt;③ 고객 음성 → 엔진: send_audio가 같은 PCM을 VAD와 Transcribe에 넘김&lt;br&gt;④ 엔진 이벤트 → 100 ms 프레임 → AUDIO_RESPONSE_CHUNK로 Connect에&lt;br&gt;⑤ end_call → LocalTools → 작별 재생 후 FINISH COMPLETE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;arcSize=8;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="bridge"><mxGeometry x="20" y="620" width="190" height="260" as="geometry"/></mxCell><mxCell id="others" value="&lt;b&gt;다른 엔진&lt;/b&gt; (지금 미사용): loopback.py 에코 테스트 · nova.py 워크숍 Nova Sonic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;arcSize=8;dashed=1;" vertex="1" parent="bridge"><mxGeometry x="620" y="670" width="400" height="50" as="geometry"/></mxCell><mxCell id="aws" value="AWS 서비스 (서울 / APAC 추론)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9F2;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#d79b00;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1320" y="150" width="280" height="790" as="geometry"/></mxCell><mxCell id="aws_stt" value="&lt;b&gt;Transcribe Streaming&lt;/b&gt;&lt;br&gt;ko-KR · WebSocket SigV4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" vertex="1" parent="aws"><mxGeometry x="20"